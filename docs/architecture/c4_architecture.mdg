---
title: "C4 Architecture for mdg-drawio"
page: "Context"
mode: layered
direction: TB
---


c4.System_Boundary(drawiogen, "mdg-drawio"):
    c4.Context_DiagramTitle("[System Context] mdg-drawio", "Converts architecture-as-code (MDG) into editable draw.io diagrams with stable node identities and manual layout preservation.")
    c4.System(drawiogen_sys, "mdg-drawio", "Ingests MDG notation source files and shape registries, computes diagram layouts, and produces valid draw.io XML.", technology="Python")

c4.Person(author, "Diagram Author / Developer", "Writes MDG source files, reviews generated diagrams, and adjusts the visual layout in draw.io when needed.", technology="")

c4.System_Ext(ai, "AI Assistant / Automation", "Reads, edits, and regenerates MDG source files — works with notation, not raw draw.io XML.", technology="LLM / AI Agent")
c4.System_Ext(drawio, "draw.io / diagrams.net", "Visual editor used to inspect, arrange, and refine the generated diagram while keeping it editable.", technology="JavaScript (Electron)")
c4.Rel(author, drawiogen_sys, "Defines architecture via MDG", description="")
c4.Rel(author, drawio, "Reviews and adjusts layout", description="")
c4.Rel(ai, drawiogen_sys, "Edits and generates MDG", description="")
c4.Rel(drawiogen_sys, drawio, "Converts MDG to draw.io; round-trip planned", description="")

---
page: "Container"
mode: layered
direction: TB
---

c4.System_Boundary(drawiogen_c, "mdg-drawio"):
    c4.Container_DiagramTitle("[Containers] mdg-drawio", "Container landscape: CLI, Engine, Contracts, Layout Engine, Generator, Notation libraries, and generated palette data.")
    c4.Container(engine, "Engine", "Orchestrates the full pipeline: loads registries and styles into memory at startup, parses MDG source files, delegates layout and XML generation, and validates the output.", technology="Python")
    c4.Container(contracts, "Contracts", "Shared data models and constants. Zero project imports — the single source of truth for types (Node, Edge, Document) and values (DEFAULT_NODE_WIDTH, PAGE_CELL_ID) that parser, layout, and generator all depend on.", technology="Python (dataclasses)")
    c4.Container(cli, "CLI", "Thin CLI entry point. Parses arguments and delegates to the Engine.", technology="Python (argparse)")
    c4.Container(layout, "Layout Engine", "Computes node positions and edge routes. Supports four layout modes — layered, process, palette, and sequence — with orthogonal edge routing.", technology="Python")
    c4.Container(generator, "Generator", "Produces valid draw.io XML from parsed Document instances. Reads geometry overlays to preserve manual layout adjustments across regenerations.", technology="Python (xml.etree)")
    c4.Container(notation, "Notation", "Seven registry-driven notation libraries sharing one block DSL engine, plus C4-specific builders. Shared core handles registry loading, exact variant dispatch, nesting validation, style lookup, and normalization.", technology="Python / YAML")
    c4.Container(palette_data, "Generated Data", "Pre-built JSON data extracted from draw.io shape libraries. Not committed. Supplies shape styles, dimensions, palette entries, and nested row-type templates consumed at startup.", technology="JSON (generated)")
    c4.Container(reverse, "Reverse Derivation & Merge", "POC: derives which registry shape a hand-drawn draw.io cell came from (weighted style match + library ranking), assigns it a semantic .mdg node id, resolves containment, and splices genuinely new cells into an existing .mdg file's text -- or, for `mdg sync`, also removes any vertex/edge no longer present, draw.io as source of truth. Exposed as the `mdg merge`/`mdg sync` CLI subcommands.", technology="Python")
    c4.Container(markup, "Markup Conversion", "Markdown <-> HTML conversion for rich-text shape labels (a table-driven subset: bold/italic/strike/headings/lists/links/images/blockquote/code/tables). Zero project imports -- stdlib only. Standalone utility, not yet wired into the DSL or generator.", technology="Python")

c4.Person(author_c, "Diagram Author / Developer", "Writes and maintains MDG files, refines diagrams visually in draw.io.", technology="")

c4.System_Ext(drawio_c, "draw.io / diagrams.net", "Visual editor used to inspect and refine generated diagrams.", technology="JavaScript (Electron)")
c4.Rel(author_c, cli, "Runs", description="")

c4.Rel(cli, engine, "Delegates to", description="")
c4.Rel(engine, reverse, "Delegates to (merge/derive verbs)", description="")
c4.Rel(reverse, notation, "Parses .mdg, derives registry shapes", description="")
c4.Rel(author_c, drawio_c, "Reviews and adjusts layout", description="")
c4.Rel(engine, notation, "Pre-loads registries and styles", description="")

c4.Rel(notation, palette_data, "Reads generated JSON", description="")
c4.Rel(engine, layout, "Delegates layout computation", description="")
c4.Rel(engine, drawio_c, "Reads and writes .drawio files", description="")
c4.Rel(engine, generator, "Delegates XML generation", description="")
c4.Rel(layout, contracts, "Uses data models", description="")
c4.Rel(notation, contracts, "Uses data models", description="")
c4.Rel(generator, contracts, "Uses data models", description="")
c4.Rel(reverse, contracts, "Uses data models", description="")

