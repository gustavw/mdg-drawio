c4.System_Boundary(drawiogen_co, "mdg-drawio"):
      c4.Component_DiagramTitle("[Components] mdg-drawio", "Engine-orchestrated pipeline: pre-load, parse, resolve layout, generate XML, validate.")

  c4.Component(cli_co, "CLI main()", "Thin entry point in mdg_drawio/cli.py. Parses --input/--output/--force, delegates to engine.convert(). Returns exit code.", technology="Python (argparse)")

  c4.Container_Boundary(engine_co_boundary, "Engine"):
      c4.Component(engine_convert_co, "convert()", "Full conversion pipeline orchestration. Detects notation, pre-loads registries/styles, parses pages, resolves layout config, injects overlays, runs layout, generates multipage XML, validates, and writes output.", technology="Python")
      c4.Component(engine_preload_co, "Pre-load", "Loads all YAML registries plus generated shape and row-type JSON into memory once at startup. Registries feed the notation registry cache; registries and styles are returned so the composition root builds the layout SizeResolver and generator StyleProvider by injection — zero filesystem I/O during parsing/layout/generation.", technology="Python (YAML/JSON)")
      c4.Component(engine_validate_co, "XML Validation", "Validates generated draw.io XML before writing: unique diagram IDs, mandatory root cells (0 and 1), and edge source/target reference integrity.", technology="Python (xml.etree)")

  c4.ContainerDb(palette_data_co, "Palette Data", "Generated JSON files from draw.io shape libraries. Produced via `make build-data`; consumed by notation style lookup.", technology="JSON (generated)")

  c4.Container_Boundary(contracts_co_boundary, "Contracts"):
      c4.Component(models_contract_co, "Models", "Shared dataclasses: Diagram, Node, Edge, Document, MultiPageDocument, GeometryPoint, Anchor, BoundaryPadding, ChildCell, NodeChildCell, GeometryChild, GeometryOverlay, EdgeAnchorOverlay, Patch. Zero project imports. Lives in contracts/models.py.", technology="Python (dataclasses)")
      c4.Component(constants_contract_co, "Constants", "Shared values: DEFAULT_NODE_WIDTH, PAGE_CELL_ID, CANVAS_DX, ROOT_CELL_ID, layout defaults, C4 scaler defaults, DSL parser constants. Zero project imports. Lives in contracts/constants.py.", technology="Python")

  c4.Container_Boundary(layout_co_boundary, "Layout Engine"):
      c4.Component(types_co, "Types & BaseLayout", "Abstract base and shared dataclasses. BaseLayout ABC, Result, SizeResolver protocol, Waypoint alias (= GeometryPoint). Node and Edge imported from contracts.", technology="Python (ABC)")
      c4.Component(config_co, "Config", "Notation-adjustable layout parameters. Config dataclass carries margins, gaps, direction, aspect ratio. resolve_page_size() computes page dimensions from content extents.", technology="Python (dataclasses)")
      c4.Component(size_resolver_co, "Size Resolver", "Concrete SizeResolver: create_size_resolver() maps node type strings to (width, height) via pre-loaded registry/style data with defaults fallback.", technology="Python (Protocol)")
      c4.Component(container_co, "Container Layout", "Parent/child boundary resolution via parent_id. apply_container_layout() lays out container interiors. absolute_node_boxes() maps page-frame positions. estimate_text_width() for label sizing.", technology="Python")
      c4.Component(layered_co, "LayeredLayout", "Sugiyama-style layered graph layout. Longest-path ranking, barycenter sweep, orthogonal 3-segment edge routing.", technology="Python (Sugiyama)")
      c4.Component(process_co, "ProcessLayout", "Left-to-right process flow layout. Wraps LayeredLayout with direction=LR. Supports rank-excluded nodes.", technology="Python")
      c4.Component(sequence_co, "SequenceLayout", "Sequence diagram layout. Nodes as participant column headers, edges as horizontal connections stacked top-to-bottom.", technology="Python")
      c4.Component(palettelayout_co, "PaletteLayout", "Reads pre-baked positions from JSON palette files. Applies exact x/y/width/height. Follows the same Result contract.", technology="Python (JSON)")

  c4.Container_Boundary(generator_co_boundary, "Generator"):
      c4.Component(generate_co, "generate()", "Produces draw.io XML from Document. Renders nodes, edges, and recursive child cells into valid mxGraphModel XML using an injected StyleProvider; compound ERD rows are reconstructed from generated row-type templates.", technology="Python (xml.etree)")
      c4.Component(overlay_co, "Overlay", "Reads existing draw.io XML to extract node positions and edge anchors. Enables manual layout preservation across regenerations via read_overlay() and read_overlay_xml().", technology="Python (xml.etree)")
      c4.Component(xml_utils_co, "XML Utils", "to_string() and indent() for XML pretty-printing.", technology="Python (xml.etree)")


  c4.Container_Boundary(notation_co_boundary, "Notation (7 libraries)"):
      c4.Component(registries_co, "YAML Registries", "Shape registries for c4, archimate3, bpmn2, erd, general, uml, uml25. Each conforms to shape-registry.schema.json and maps DSL functions to palette shapes.", technology="YAML")
      c4.Component(registry_co, "Registry", "Loads YAML shape registries. Exposes set_registries(), shapes_by_id(), shapes_by_function(). Maintains LIBRARIES tuple. Lives in notation/_core/.", technology="Python (PyYAML)")
      c4.Component(styles_co, "Styles", "Locates generated shape and row-type palette data (DATA_DIR under mdg_drawio/generated_data). Read once at startup and injected into layout and generator ports — no runtime cache. Lives in notation/_core/.", technology="Python")
      c4.Component(normalize_co, "Normalize", "Style normalization and fingerprinting. Sorts/deduplicates draw.io style tokens for stable identity. style_fingerprint() binds registry entries to palette cells. Lives in notation/_core/.", technology="Python")
      c4.Component(palette_co, "Palette", "Palette entry grouping utilities. Groups cells by menu entry boundary. Provides flatten_entries() and anchor_cell() for palette layout. Lives in notation/_core/.", technology="Python")
      c4.Component(dsl_engine_co, "DSL Engine (_core)", "Shared notation-agnostic primitives. Regex call matching, block definitions, YAML frontmatter parsing, page splitting (per-page and legacy), AST argument parsing, indent-based container-stack block parser, passthrough node/edge support for foreign namespaces. NodeBuilder/EdgeBuilder/IsEdge protocols. DslError exception. Lives in notation/_core/.", technology="Python (regex/ast)")
      c4.Component(grammar_co, "GRAMMAR.md", "Canonical DSL language specification. Defines document structure, call syntax, nesting rules, and how agents should use registries.", technology="Markdown")
      c4.Component(stubs_co, "Notation Parsers", "All seven libraries parse through the shared registry-driven DSL engine; C4 additionally supplies native node/edge builders. Library packages expose registries, coverage documents, and optional layout hooks.", technology="Python / YAML")

  c4.Person(author_co, "Diagram Author / Developer", "Writes MDG source, refines layout visually in draw.io.", technology="")

c4.Rel(author_co, cli_co, "Runs", description="")
