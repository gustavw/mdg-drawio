c4.Rel(size_resolver_co, config_co, "Uses layout config", description="")
c4.Rel(size_resolver_co, container_co, "Reuses text sizing", description="")
c4.Rel(layered_co, types_co, "Implements BaseLayout", description="")
c4.Rel(layered_co, config_co, "Uses layout config", description="")
c4.Rel(layered_co, container_co, "Uses container layout", description="")
c4.Rel(process_co, layered_co, "Wraps for LR direction", description="")
c4.Rel(process_co, types_co, "Implements BaseLayout", description="")
c4.Rel(process_co, config_co, "Uses layout config", description="")
c4.Rel(sequence_co, types_co, "Implements BaseLayout", description="")
c4.Rel(sequence_co, config_co, "Uses layout config", description="")
c4.Rel(palettelayout_co, types_co, "Implements BaseLayout", description="")
c4.Rel(palettelayout_co, config_co, "Uses layout config", description="")
c4.Rel(dsl_engine_co, registry_co, "Loads via registry", description="")
c4.Rel(dsl_engine_co, contracts_co_boundary, "Uses contracts", description="")
c4.Rel(dsl_engine_co, registries_co, "Resolves shapes via registries", description="")
c4.Rel(registry_co, registries_co, "Loads YAML registries", description="")
c4.Rel(styles_co, palette_data_co, "Locates generated JSON", description="")
