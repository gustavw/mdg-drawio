---
title: "UML 2.5 Shapes Coverage"
mode: palette
---

# NOTE ON SPELLING:
# Several labels below preserve typos that exist in the live draw.io UML 2.5
# palette source, kept verbatim so each entry stays byte-identical to the
# draw.io tooltip/menu name for reliable association:
#   - "preudostate"  (#39)  draw.io's spelling of "pseudostate"
#   - "Occurence"    (#90)  draw.io's spelling of "Occurrence"
#   - "Secification" (#123, #124)  draw.io's spelling of "Specification"
# Corrected spellings are noted only in comments; do not "fix" the labels.
#
# NOTE ON uml25.Raw:
# uml25.Raw is the generic fallback builder for palette entries that do not yet
# have a dedicated shape function. It intentionally does NOT collide with entry
# #1 "Diagram", which now uses the dedicated uml25.Diagram builder.
#
# NOTE ON ROW TYPES (nested children):
# Nested rows are not all the same style. draw.io distinguishes them, so the DSL
# uses semantic row types instead of a single overloaded Item:
#   Item(id, text)               left-aligned member/content row (the default)
#   Header(id, text)             center-aligned compartment label (e.g. "attributes",
#                                "operations", "provided interfaces")
#   Note(id, text)               bold stub, typically an internal-structure placeholder
#                                (fontStyle=1)
#   Divider(id, text="")         plain separator line
#   Divider(id, text, dashed=True)   dashed separator, optional label
#   Lane(id, text="")            partialRectangle swimlane cell (Activity Partition,
#                                Lifeline timing lanes)
# Right-aligned action rows (variable/self/value) are NOT rows here; they are passed
# as arguments (variable=, binding=, value=) and the builder sets align=right.
#
# NOTE ON FIXED-PART ARGUMENTS:
# Some shapes carry a fixed sub-element that draw.io pins to the template
# (style part=1;resizeWidth=1) rather than a row that scales. Those are passed
# as keyword arguments (keyword=, name=, body=, entry=, exit=, annotation=,
# stream=, variable=, value=, binding=, multiplicity=, heading=, condition=,
# node=, inv1=, inv2=) instead of nested uml25.Item rows. Genuine stackLayout
# tables (attribute/operation/property/literal lists, etc.) remain nested so
# they can grow.

use uml25

uml25.UML25("UML 2.5 Shapes Coverage")
    uml25.Diagram(n1, "Diagram Heading")  # 1. Diagram
    uml25.Comment(n2, "Comment1 body")  # 2. Comment
    uml25.TemplateSignature(n3, "Template1 signature")  # 3. Template signature
    uml25.TemplateSignature(n4, "Template parameter 1\nTemplate parameter 2", variant=2)  # 4. Template signature
    uml25.Constraint(n5, "Constraint1 specification", keyword="<<keyword>>")  # 5. Constraint
    uml25.Classifier(n6, "<<keyword>> Classifier1 {abstract}"):  # 6. Classifier
        uml25.Header(c2, "attributes")
        uml25.Item(c3, "attribute1")
        uml25.Item(c4, "inherited attribute2")
        uml25.Item(c5, "...")
        uml25.Divider(c6, "")
        uml25.Header(c7, "operations")
        uml25.Item(c8, "operation1")
    uml25.Classifier(n7, "Classifier1", variant=2)  # 7. Classifier
    uml25.Classifier(n8, "Classifier1", variant=3):  # 8. Classifier
        uml25.Header(c9, "internal structure")
        uml25.Note(c10, "")
    uml25.Association(n9, "Association1")  # 9. Association
    uml25.Classifier(n10, "Instance1", variant=4):  # 10. Classifier
        uml25.Item(c11, "slot1")
        uml25.Divider(c12, "")
        uml25.Header(c13, "internal structure")
        uml25.Note(c14, "")
    uml25.Instance(n11, "Instance1 value")  # 11. Instance
    uml25.Classifier(n12, "<<enumeration>> Enum1", variant=5):  # 12. Classifier
        uml25.Item(c15, "literal1")
    uml25.InterfaceGeneralization(None, None, "Interface1, Interface2...")  # 13. Interface Generalization
    uml25.RequiredInterface(None, None, "Interface1")  # 14. Required Interface
    uml25.Property(n13, "0..1", name="Property1")  # 15. Property
    uml25.Property(n14, "Property1", variant=2)  # 16. Property
    uml25.Port(n15, "port1")  # 17. Port
    uml25.PortWithProvidedInterface(n16, "")  # 18. Port with provided interface
    uml25.PortWithRequiredInterface(n17, "")  # 19. Port with required interface
    uml25.Component(n18, ""):  # 20. Component
        uml25.Item(c17, "Component")
        uml25.Divider(c18, "")
        uml25.Header(c19, "provided interfaces")
        uml25.Item(c20, "Interface1")
        uml25.Divider(c21, "")
        uml25.Header(c22, "required interfaces")
        uml25.Item(c23, "Interface2")
    uml25.Classifier(n19, "", variant=6):  # 21. Classifier
        uml25.Header(c24, "Collaboration1")
        uml25.Divider(c25, "", dashed=True)
        uml25.Header(c26, "Classifier1")
        uml25.Header(c27, "Collaboration use 1")
        uml25.Item(c28, "Classifier2")
    uml25.Package(n20, "Package1")  # 22. Package
