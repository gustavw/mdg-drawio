    uml25.Icon(n27, "icon")  # 29. Icon
    uml25.Region(n28, "")  # 30. Region
    uml25.State(n29, "State1 [invariant1] <<extended/final>>"):  # 31. State
        uml25.Item(c36, "")
        uml25.Divider(c37, "")
        uml25.Item(c38, "behavior1")
        uml25.Divider(c39, "")
        uml25.Item(c40, "transition1")
    uml25.State(n30, "State1", variant=2)  # 32. State
